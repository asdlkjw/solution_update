            color: var(--text-secondary);
            background: transparent;
        }

        .page-indicator {
            font-size: 0.9rem;
            color: var(--text-secondary);
            min-width: 150px;
            text-align: center;
        }

        /* Main Content */
        #app {
            flex: 1;
            display: flex;
            overflow: hidden;
            padding: 20px;
            gap: 20px;
        }

        .panel {
            flex: 1;
            display: flex;
            flex-direction: column;
