            margin: 0 4px;
            transition: transform 0.2s;
        }

        /* Field Styling for MathJax Rendering */
        .field-wrapper {
            padding: 12px 0;
            border-bottom: 1px solid var(--border-color);
        }

        .field-wrapper:last-child {
