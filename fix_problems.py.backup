#!/usr/bin/env python3
import os
import sys
import json
import argparse
import csv
import pymysql
import pymysql.cursors
import requests
from dotenv import load_dotenv
from pathlib import Path
from typing import List, Dict, Any, Literal
from concurrent.futures import ThreadPoolExecutor, as_completed

env_path = Path(__file__).resolve().parent.parent / ".env"
load_dotenv(dotenv_path=env_path)

OPENROUTER_API_KEY = os.getenv("OPENROUTER_API_KEY")
DB_HOST = os.getenv("DB_HOST")
DB_PORT = os.getenv("DB_PROD_PORT")
DB_USER = os.getenv("DB_USER")
DB_PASSWORD = os.getenv("DB_PROD_PASSWORD")
DB_NAME = os.getenv("DB_NAME")

MODEL_NAME = "google/gemini-3-flash-preview"
OPENROUTER_URL = "https://openrouter.ai/api/v1/chat/completions"


def read_group_ids_from_csv(csv_path: str) -> List[int]:
    # CSV 파일에서 group_id 목록을 읽어옵니다.
    group_ids = []
    try:
        with open(csv_path, "r", encoding="utf-8") as f:
            reader = csv.reader(f)
            for row in reader:
                if row:  # 빈 줄 무시
                    group_ids.append(int(row[0].strip()))
        return group_ids
    except FileNotFoundError:
        print(f"Error: CSV file not found at {csv_path}", file=sys.stderr)
        sys.exit(1)
    except ValueError as e:
        print(f"Error parsing CSV file: {e}", file=sys.stderr)
        sys.exit(1)


def get_db_connection():
    # 데이터베이스 연결을 생성합니다.
    try:
        conn = pymysql.connect(
            host=DB_HOST,
            port=int(DB_PORT) if DB_PORT else 3306,
            user=DB_USER,
            password=DB_PASSWORD,
            database=DB_NAME,
            cursorclass=pymysql.cursors.DictCursor,
        )
        return conn
    except Exception as e:
        print(f"Error connecting to database: {e}", file=sys.stderr)
        sys.exit(1)


def fetch_problems(
    ids: List[int] | None = None,
    group_ids: List[int] | None = None,
    mode: Literal["id", "group_id"] = "id",
) -> List[Dict[str, Any]]:
    # ID 또는 group_id 리스트에 해당하는 문제 데이터를 가져옵니다.
    conn = get_db_connection()
    # Connection 객체 생성 시 cursorclass를 지정했으므로 여기서는 그냥 cursor() 호출
    cursor = conn.cursor()

    # 식별을 위해 id 컬럼은 필수로 포함하고, 나머지는 요청된 컬럼만 조회
    cols = "id, group_id, type, question, refer, choice1, choice2, choice3, choice4, choice5, answer, solution, human_review"

    try:
        if mode == "id":
            # ID 기반 조회
            if ids is None or len(ids) == 0:
                return []
            if len(ids) == 1:
                query = f"SELECT {cols} FROM problem WHERE id = %s"
                cursor.execute(query, (ids[0],))
            else:
                # pymysql에서 IN 절 처리를 위해 %s 사용 및 튜플 전달
                format_strings = ",".join(["%s"] * len(ids))
                query = f"SELECT {cols} FROM problem WHERE id IN ({format_strings})"
                cursor.execute(query, tuple(ids))
        elif mode == "group_id":
            # group_id 기반 조회
            if group_ids is None or len(group_ids) == 0:
                return []
            if len(group_ids) == 1:
                query = f"SELECT {cols} FROM problem WHERE group_id = %s"
                cursor.execute(query, (group_ids[0],))
            else:
                # pymysql에서 IN 절 처리를 위해 %s 사용 및 튜플 전달
                format_strings = ",".join(["%s"] * len(group_ids))
                query = (
                    f"SELECT {cols} FROM problem WHERE group_id IN ({format_strings})"
                )
                cursor.execute(query, tuple(group_ids))

        rows = cursor.fetchall()
        return rows  # pymysql DictCursor returns list of dicts directly
    except Exception as e:
        print(f"Error fetching data: {e}", file=sys.stderr)
        return []
    finally:
        cursor.close()
        conn.close()


def fix_content_with_llm(problem_data: Dict[str, Any]) -> Dict[str, Any]:
    # OpenRouter Gemini 모델을 사용하여 문제 내용을 수정합니다.

    # LLM 입력용 필드 필터링
    target_fields = [
        "type",
        "question",
        "refer",
        "choice1",
        "choice2",
        "choice3",
        "choice4",
        "choice5",
        "answer",
        "solution",
    ]
    # DB에서 가져온 데이터 중 target_fields에 해당하는 것만 추출
    filtered_input = {k: problem_data.get(k) for k in target_fields}

    serialized_data = json.loads(json.dumps(filtered_input, default=str))

    prompt = f"""
You are an expert math problem editor. Your task is to fix all formatting errors, typos, and LaTeX issues in the provided math problem data.

## Task Overview
Fix the following fields in the JSON data:
- type, question, refer, choice1, choice2, choice3, choice4, choice5, answer, solution

The data contains HTML + LaTeX content. Transform it into well-structured HTML for human readability while ensuring all math expressions use proper LaTeX delimiters ($...$).

## IMPORTANT: HTML Structure Rules for Human Readability
Transform content into well-structured HTML with proper wrapping:

1. **Sentence-level wrapping**: Wrap individual sentences with `<p>` tags
2. **Paragraph-level wrapping**: Wrap paragraphs with `<div>` tags
3. **List formatting**: Format "보기" (choices/examples) as `<ol><li>` lists
4. **Field-specific class names** - Apply these class attributes:
   - question field: Wrap the entire content with `<div class='question'>...</div>`
   - refer field: Wrap the entire content with `<div class='reference'>...</div>`
   - Each choice (choice1~5): Wrap with `<div class='choice'>...</div>`
   - answer field: Wrap with `<div class='answer'>...</div>`
   - solution field: Wrap with `<div class='solution'>...</div>`

Example output structure:
- question: `<div class='question'><p>Problem text with $x^2$...</p><p>Next sentence...</p></div>`
- refer: `<div class='reference'><ol><li>First item</li><li>Second item</li></ol></div>`
- choice1: `<div class='choice'>$a^2 + b^2$</div>`

## Error Definitions & Fixes

1. **type correction**:
   - "객관식" (objective) → "multiple_choice"
   - "주관식" (subjective) → "short_answer"

2. **LaTeX fraction & displaystyle issues**:
   - Change small \\frac to \\cfrac for better readability.
   - Add \\displaystyle before \\int, \\sum, \\prod, \\lim, etc. when not present.
   - For inline subscripts/superscripts like _{{}}, ^{{}}, use \\tfrac or \\frac instead of \\cfrac to keep them small.

3. **Remove scoring information**: Remove any point/score references from question and refer (e.g., [4점], (3.5점), 등).

4. **Add missing math delimiters**: Wrap math expressions, numbers, English letters, and symbols with $...$ if not already delimited.
   - Examples: a → $a$, 2 → $2$, x → $x$

5. **Clean up refer field**:
   - If refer contains non-[보기] (not example choices) information, move it to question.
   - If refer is completely irrelevant to the problem, remove it.
   - **IMPORTANT**: Check if original refer has counter symbols (1., 2., 3., ㉠, ㉡, etc.).
     - If counter symbols exist, format as <ol><li> list.
     - If NO counter symbols exist, use <p> tags for each option instead.

6. **Fix incomplete problems**: If the problem itself has errors (missing parts), predict and complete it logically.

7. **Correct answer and solution**: Recalculate and provide the correct answer and solution while maintaining the existing writing style.

8. **Fix spacing**: Correct any incorrect spacing (띄어쓰기) issues.

9. **Translate English math terms**: Convert English abbreviations to Korean appropriate for students.
   - gcd → 최대공약수, lcm → 최소공배수, etc.

10. **Simplify explanations in solution**: Remove college-level concepts or overly advanced methods. Use middle/high school level explanations.
    - Example: Instead of "가우스 법칙을 사용한다", use appropriate middle/high school methods.

11. **Deduplicate choices**: If question/refer/choice fields have duplicate content (especially choices), move choices from question/refer to choice1~5 fields.

12. **Remove orphaned subproblem labels**: If only (1), (2), etc. appear as a subproblem marker with no other subproblems, simplify by removing the label and keeping just the expression.
    - Example: (1) $\sqrt{{3}}^5 + 2$ → $\sqrt{{3}}^5 + 2$

13. **Remove problem type labels**: Remove [서술형], [주관식1], 주관식 [1~4], etc. from question.

14. **Fix plain text fractions**: Convert 1/2 style to \cfrac{{1}}{{2}}.

15. **Convert non-LaTeX math tags**: Replace <math>...</math> with $...$.
    - Example: <math>2</math> → $2$

16. **Remove duplicate sentences**: Remove redundant duplicate sentences.
    - Example: "답은 $135$이다. 따라서 답은 ④ $135$이다." → "따라서 답은 ④ $135$이다."

17. **Fix typos**: Correct any typos.

18. **Consistent writing style**: Ensure consistent ending style (use "~다" instead of "~입니다", etc.).

## CRITICAL: HTML Formatting Rules

1. **NEVER escape HTML tags**: All HTML tags must be written as normal HTML, NOT escaped.
   - Use normal HTML: <p>, </p>, <div>, </div>, <ol>, </ol>, <li>, </li>
   - NEVER use escaped versions like \\/p>, \\/div>, \\/li>, etc.
   - NEVER add backslashes before HTML tags

2. **MathJax delimiters supported**:
   - Inline: $x^2$, \\(x^2\\), \\(x^2\\)
   - Display: $$x^2$$, \\[x^2\\]
   - All three styles work, choose appropriate one

3. **HTML structure examples** (these are correct - copy this style):
   <div class='question'><p>다음 식의 값을 구하시오.</p><p>$$\\displaystyle\\int_0^1 x dx$$</p></div>
   <div class='reference'><ol><li>$a^2$</li><li>$2ab$</li></ol></div>
   <div class='choice'><p>① $a^2 + b^2$</p></div>
   <div class='answer'><p>② $2ab$</p></div>
   <div class='solution'><p><strong>해설:</strong></p><p>$$(a+b)^2 = a^2 + 2ab + b^2$$</p></div>

## Input Data
{json.dumps(serialized_data, indent=2, ensure_ascii=False)}

Return corrected JSON. All HTML must be properly formatted WITHOUT any escape characters.

    headers = {
        "Authorization": f"Bearer {OPENROUTER_API_KEY}",
        "Content-Type": "application/json",
        "HTTP-Referer": "https://github.com/code-yeongyu/sisyphus",
        "X-Title": "Problem Fix Script",
    }

    json_schema = {
        "type": "object",
        "properties": {
            "type": {"type": "string", "enum": ["multiple_choice", "short_answer"]},
            "question": {"type": "string"},
            "refer": {"type": ["string", "null"]},
            "choice1": {"type": ["string", "null"]},
            "choice2": {"type": ["string", "null"]},
            "choice3": {"type": ["string", "null"]},
            "choice4": {"type": ["string", "null"]},
            "choice5": {"type": ["string", "null"]},
            "answer": {"type": "string"},
            "solution": {"type": ["string", "null"]},
        },
        "required": [
            "type",
            "question",
            "refer",
            "choice1",
            "choice2",
            "choice3",
            "choice4",
            "choice5",
            "answer",
            "solution",
        ],
        "additionalProperties": False,
    }

    payload = {
        "model": MODEL_NAME,
        "messages": [{"role": "user", "content": prompt}],
        "response_format": {
            "type": "json_schema",
            "json_schema": {
                "name": "math_problem_correction",
                "strict": True,
                "schema": json_schema,
            },
        },
    }

    try:
        response = requests.post(
            OPENROUTER_URL, headers=headers, json=payload, timeout=60
        )
        response.raise_for_status()
        result = response.json()

        content = result["choices"][0]["message"]["content"]
        return json.loads(content)
    except Exception as e:
        print(
            f"Error calling LLM for ID {problem_data.get('id')}: {e}", file=sys.stderr
        )
        return {"error": str(e), "original_id": problem_data.get("id")}


def process_single_problem(problem: Dict[str, Any]) -> Dict[str, Any]:
    # 단일 문제 처리를 위한 래퍼 함수 (병렬 실행용)
    print(f"Processing ID: {problem.get('id')}...")
    fixed_data = fix_content_with_llm(problem)
    return {
        "original_id": problem.get("id"),
        "original": json.loads(json.dumps(problem, default=str)),
        "fixed": fixed_data,
    }


